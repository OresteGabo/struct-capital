# Generate with true only for reviewed public launch content.
# Static output must be regenerated after changing this flag.
NUXT_PUBLIC_SITE_INDEXABLE=false

# Default off. Pure static hosting must keep this false.
# Enable at BUILD time only for a server deployment with an approved contact service.
NUXT_PUBLIC_CONTACT_ENABLED=false
# Private server settings: never put the target URL or token in public runtime config.
# No Spring inquiry endpoint currently exists. Supply an approved separate service only.
# HTTPS, plain path, no query/fragment/userinfo; /api/bonds and encoded paths are rejected.
NUXT_CONTACT_ENDPOINT=
NUXT_CONTACT_TOKEN=
NUXT_CONTACT_ORIGIN=https://structcapital.net
